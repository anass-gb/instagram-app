# ─────────────────────────────────────────────────────────────────────────────
#  Dockerfile — Frontend Expo (serveur de développement)
#  Lance expo start --tunnel pour que le téléphone se connecte via QR code
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Installe les outils système nécessaires à Expo
RUN apk add --no-cache git curl bash

# Installe expo-cli globalement
RUN npm install -g expo-cli @expo/ngrok

# Copie les dépendances en premier (cache Docker)
COPY package.json ./
RUN npm install

# Copie le reste du code
COPY . .

EXPOSE 8081 19000 19001 19002

# Lance Expo en mode tunnel → QR code accessible partout (même réseau différent)
CMD ["npx", "expo", "start", "--tunnel"]
