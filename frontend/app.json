{
  "expo": {
    "name": "InstaClone",
    "slug": "instaclone",
    "version": "1.0.0",
    "scheme": "instaclone",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.app.instaclone"
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0A0A0A" },
      "package": "com.app.instaclone",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-camera",       { "cameraPermission": "Accès caméra pour les stories et posts." }],
      ["expo-image-picker", { "photosPermission": "Accès galerie pour publier des photos." }],
      ["expo-media-library", { "photosPermission": "Accès galerie." }],
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#1DB954" }],
      ["expo-location",     { "locationAlwaysAndWhenInUsePermission": "Localisation pour les posts." }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
